{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "pages/api/*.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/lottery",
      "dest": "/pages/api/lottery.ts"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
